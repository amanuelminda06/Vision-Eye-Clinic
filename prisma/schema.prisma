generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  RECEPTION
  STAFF
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  VOIDED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  CARD
  OTHER
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// How a Shift row was produced — from a weekly template or entered by hand.
enum ShiftSource {
  TEMPLATE
  MANUAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

/// Where an appointment came from: booked at the clinic vs. a website request.
enum AppointmentSource {
  STAFF
  WEBSITE_REQUEST
}

enum RequestStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
  SPAM
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

/// Non-clinical patient messages the clinic prepares and sends by hand.
enum MessageTemplateKey {
  APPT_REMINDER
  APPT_CONFIRMATION
  APPT_SAME_DAY
  NO_SHOW
  SCHEDULE_CHANGE
  FOLLOWUP_DUE
  RECALL
  GLASSES_READY
  THANK_YOU
  BIRTHDAY
  WELCOME
  CLOSURE_NOTICE
  CUSTOM
}

/// What produced a MessageTask.
enum MessageSourceType {
  APPOINTMENT
  FOLLOWUP
  BIRTHDAY
  RECALL
  CAMPAIGN
  MANUAL
}

enum MessageStatus {
  PENDING
  OPENED
  SENT
  SKIPPED
  EXPIRED
  CANCELLED
  BLOCKED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id                 String    @id @default(cuid())
  name               String
  /// Stored lowercase — zod transforms inputs before write.
  email              String    @unique
  passwordHash       String
  role               Role
  staffId            String?   @unique
  staff              Staff?    @relation(fields: [staffId], references: [id])
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz
  lastLoginAt        DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz

  @@index([createdAt])
}

model Staff {
  id              String          @id @default(cuid())
  fullName        String
  jobTitle        String
  isDoctor        Boolean         @default(false)
  specialty       String?
  phone           String?
  photoUrl        String?
  showOnWebsite   Boolean         @default(false)
  active          Boolean         @default(true)
  /// Annual leave entitlement in days (optional — no balance shown when null).
  annualLeaveDays Int?
  users           User[]
  salesAsDoctor   Sale[]
  shiftTemplates  ShiftTemplate[]
  shifts          Shift[]
  leaveRequests   LeaveRequest[]
  appointmentsAsDoctor Appointment[]
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  @@index([active, isDoctor])
}

/// A weekly recurring shift pattern (clinic-local wall-clock times).
/// `endTime <= startTime` means the shift crosses midnight into the next day.
model ShiftTemplate {
  id        String    @id @default(cuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday (matches Date.getUTCDay()).
  weekday   Int
  /// "HH:mm" in clinic-local time.
  startTime String
  /// "HH:mm" in clinic-local time (may be <= startTime for overnight shifts).
  endTime   String
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  @@index([staffId, weekday])
}

/// A concrete worked shift. May cross midnight — stored as UTC instants.
model Shift {
  id        String      @id @default(cuid())
  staffId   String
  staff     Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startsAt  DateTime    @db.Timestamptz
  endsAt    DateTime    @db.Timestamptz
  source    ShiftSource @default(MANUAL)
  note      String?
  /// User id of the creator (no FK — users are never deleted).
  createdBy String
  createdAt DateTime    @default(now()) @db.Timestamptz
  updatedAt DateTime    @updatedAt @db.Timestamptz

  @@index([staffId, startsAt])
  @@index([startsAt])
}

/// A staff leave request and its decision (only the OWNER decides).
model LeaveRequest {
  id           String      @id @default(cuid())
  staffId      String
  staff        Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type         LeaveType
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  halfDay      Boolean     @default(false)
  reason       String?
  status       LeaveStatus @default(REQUESTED)
  decidedBy    String?
  decidedAt    DateTime?   @db.Timestamptz
  decisionNote String?
  /// User id of the requester (the staff member or the OWNER entering on their behalf).
  createdBy    String
  createdAt    DateTime    @default(now()) @db.Timestamptz
  updatedAt    DateTime    @updatedAt @db.Timestamptz

  @@index([staffId, startDate])
  @@index([status])
}

/// A booked patient appointment with a doctor.
model Appointment {
  id           String            @id @default(cuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       Staff             @relation(fields: [doctorId], references: [id])
  /// UTC instants — day buckets use the clinic timezone.
  startsAt     DateTime          @db.Timestamptz
  endsAt       DateTime          @db.Timestamptz
  serviceId    String?
  service      Service?          @relation(fields: [serviceId], references: [id])
  status       AppointmentStatus @default(SCHEDULED)
  cancelReason String?
  /// Free text. NON-CLINICAL ONLY — never store diagnoses or care details.
  notes        String?
  createdFrom  AppointmentSource @default(STAFF)
  /// User id of the creator (no FK — users are never deleted).
  createdBy    String
  createdAt    DateTime          @default(now()) @db.Timestamptz
  updatedAt    DateTime          @updatedAt @db.Timestamptz

  appointmentRequest AppointmentRequest?

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
  @@index([startsAt])
}

/// A website visitor asking to book an appointment. Publicly created; ipHash
/// only (the raw IP is never stored).
model AppointmentRequest {
  id                  String        @id @default(cuid())
  name                String
  /// E.164 — normalized by src/lib/phone.ts before write.
  phoneE164           String
  /// Preferred calendar day, clinic-local `YYYY-MM-DD`.
  preferredDate       String
  /// Free text window ("morning", "afternoon", …).
  preferredTimeWindow String?
  /// Service interest — free text or a service id.
  serviceInterest     String?
  /// Free text, max 500 chars.
  message             String?
  language            String        @default("en")
  status              RequestStatus @default(NEW)
  /// User id of the staff member who handled the request.
  handledBy           String?
  handledAt           DateTime?     @db.Timestamptz
  /// Linked patient (null until converted, or when no match was found yet).
  patientId           String?
  patient             Patient?      @relation(fields: [patientId], references: [id])
  /// Linked appointment once the request is CONVERTED.
  appointmentId       String?       @unique
  appointment         Appointment?  @relation(fields: [appointmentId], references: [id])
  /// sha-256 hex of the submitter's IP (privacy — never store the raw IP).
  ipHash              String
  createdAt           DateTime      @default(now()) @db.Timestamptz

  @@index([status, createdAt])
  @@index([phoneE164])
}

/// A scheduled recall/review for a patient (non-clinical reason text).
model FollowUp {
  id                       String         @id @default(cuid())
  patientId                String
  patient                  Patient        @relation(fields: [patientId], references: [id])
  /// Clinic-local calendar day (no time component).
  dueDate                  DateTime       @db.Date
  reason                   String?
  status                   FollowUpStatus @default(OPEN)
  /// Appointment that produced this follow-up (no FK — appointments persist).
  createdFromAppointmentId String?
  /// User id of the creator (no FK — users are never deleted).
  createdBy                String
  createdAt                DateTime       @default(now()) @db.Timestamptz
  updatedAt                DateTime       @updatedAt @db.Timestamptz

  @@index([status, dueDate])
  @@index([patientId])
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz
}

/// Editable public-website copy (CMS lite). One row per content key, bilingual.
/// Amharic values are drafts that need a native-speaker review.
model SiteContent {
  key       String   @id
  valueEn   String   @db.Text
  valueAm   String   @db.Text
  /// User id of the last editor (no FK — users are never deleted).
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  entity    String
  entityId  String
  action    String
  oldJson   Json?
  newJson   Json?
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([entity, action, createdAt])
}

model Patient {
  id                 String       @id @default(cuid())
  fullName           String
  /// E.164 (+2519…/+2517…) — normalized by src/lib/phone.ts before write.
  phoneE164          String       @unique
  sex                Sex?
  /// Date of birth, no time component.
  birthDate          DateTime?    @db.Date
  /// BCP-47 tag (`en`/`am`); copied from the default_language setting on create.
  preferredLanguage  String       @default("en")
  /// Free text. NON-CLINICAL ONLY — never store diagnoses or care details.
  notesNonClinical   String?
  consentSms         Boolean      @default(false)
  consentDate        DateTime?    @db.Timestamptz
  /// User id of the staff member who recorded the SMS consent.
  consentRecordedBy  String?
  doNotMessage       Boolean      @default(false)
  doNotMessageReason String?
  active             Boolean      @default(true)
  /// User id of the creator (no FK — users are never deleted).
  createdBy          String
  createdAt          DateTime     @default(now()) @db.Timestamptz
  updatedAt          DateTime     @updatedAt @db.Timestamptz
  tags               PatientTag[]

  sales Sale[]

  appointments        Appointment[]
  appointmentRequests AppointmentRequest[]
  followUps           FollowUp[]
  messages            MessageTask[]

  @@index([fullName])
  @@index([birthDate])
  @@index([active])
  @@index([createdAt])
}

model Tag {
  id       String       @id @default(cuid())
  /// Lowercase display name — the app lowercases before write.
  name     String       @unique
  /// Hex colour, e.g. `#3B82F6`.
  color    String
  patients PatientTag[]
}

model PatientTag {
  patientId String
  tagId     String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([patientId, tagId])
}

model Service {
  id           String   @id @default(cuid())
  /// English display name.
  name         String
  /// Amharic display name (optional — falls back to `name`).
  nameAm       String?
  /// Stable category key, validated against the app's fixed list.
  category     String
  /// Price used for NEW sales. Existing sale lines keep their own snapshot.
  currentPrice Decimal  @default(0) @db.Decimal(12, 2)
  active       Boolean  @default(true)
  /// Listed on the public website. The price is NEVER exposed publicly.
  isPublic             Boolean @default(false)
  /// Website description (en); falls back to nothing when blank.
  publicDescriptionEn  String?
  /// Website description (am); falls back to the en text when blank.
  publicDescriptionAm  String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  priceHistory ServicePriceHistory[]
  saleLines    SaleLine[]
  appointments Appointment[]

  @@index([category])
  @@index([name])
}

model ServicePriceHistory {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  /// User id of the editor (no FK — users are never deleted).
  changedBy String
  changedAt DateTime @default(now()) @db.Timestamptz

  @@index([serviceId, changedAt])
}

model Sale {
  id            String        @id @default(cuid())
  /// Per-year, gap-free receipt number, e.g. `2026-000123`.
  receiptNumber String        @unique
  patientId     String?
  patient       Patient?      @relation(fields: [patientId], references: [id])
  doctorId      String?
  doctor        Staff?        @relation(fields: [doctorId], references: [id])
  /// UTC instant of the sale — day buckets use the clinic timezone.
  saleDate      DateTime      @db.Timestamptz
  status        SaleStatus    @default(DRAFT)
  paymentMethod PaymentMethod
  /// Server-computed sum of line totals. Never taken from the client.
  total         Decimal       @db.Decimal(12, 2)

  voidRequestedBy   String?
  voidRequestReason String?
  voidedBy          String?
  voidReason        String?
  voidedAt          DateTime? @db.Timestamptz

  /// User id of the creator/confirming user (no FK — users are never deleted).
  createdBy   String
  confirmedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  lines SaleLine[]

  @@index([saleDate])
  @@index([status, saleDate])
  @@index([patientId])
  @@index([doctorId])
  @@index([createdBy, saleDate])
  @@index([paymentMethod])
  @@index([status, voidRequestedBy])
}

model SaleLine {
  id                  String  @id @default(cuid())
  saleId              String
  sale                Sale    @relation(fields: [saleId], references: [id])
  serviceId           String
  service             Service @relation(fields: [serviceId], references: [id])
  /// Name captured at sale time — later renames never touch history.
  serviceNameSnapshot String
  /// Integer quantity, always >= 1.
  qty                 Int
  /// Service price captured at sale time.
  unitPrice           Decimal @db.Decimal(12, 2)
  /// unitPrice * qty, computed server-side only.
  lineTotal           Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([serviceId])
}

/// Gap-free receipt numbering: claimed with a single atomic upsert
/// (INSERT … ON CONFLICT DO UPDATE … RETURNING) inside the sale transaction.
model ReceiptCounter {
  /// Calendar year in the clinic timezone, e.g. 2026.
  year       Int @id
  lastNumber Int @default(0)
}

/// Editable SMS wording. One row per (key, language). Amharic rows are drafts
/// that need a native-speaker review (surfaced in the editor).
model MessageTemplate {
  id        String             @id @default(cuid())
  key       MessageTemplateKey
  /// `en` or `am` (validated by the app).
  language  String
  body      String
  active    Boolean            @default(true)
  /// User id of the last editor (no FK — users are never deleted).
  updatedBy String?
  createdAt DateTime           @default(now()) @db.Timestamptz
  updatedAt DateTime           @updatedAt @db.Timestamptz

  @@unique([key, language])
}

/// One prepared message for one patient. Generated idempotently: the unique
/// tuple prevents duplicate tasks from repeated hooks or job runs.
model MessageTask {
  id              String             @id @default(cuid())
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id])
  templateKey     MessageTemplateKey
  sourceType      MessageSourceType
  /// Source record id (appointment/follow-up id, or a stable period key). Never null.
  sourceId        String
  campaignId      String?
  campaign        Campaign?          @relation(fields: [campaignId], references: [id])
  /// `en` or `am` — the language the message was rendered in.
  language        String
  /// Final text (variables already substituted); a one-off edit may change it.
  renderedMessage String
  dueAt           DateTime           @db.Timestamptz
  /// Deadline by which the message should have been sent (null = no deadline).
  sendBy          DateTime?          @db.Timestamptz
  /// After this the task auto-expires (null = never).
  expiresAt       DateTime?          @db.Timestamptz
  status          MessageStatus      @default(PENDING)
  /// Why a task is BLOCKED (i18n key, e.g. `noConsent`). Null unless BLOCKED.
  blockedReason   String?
  /// Free-text reason recorded when a task is SKIPPED.
  skipReason      String?
  /// User id that handled (sent/skipped) the task.
  handledBy       String?
  handledAt       DateTime?          @db.Timestamptz
  /// Set when the rendered text was edited before sending.
  editedBy        String?
  editedAt        DateTime?          @db.Timestamptz
  createdAt       DateTime           @default(now()) @db.Timestamptz

  @@unique([sourceType, sourceId, templateKey, patientId])
  @@index([status, dueAt])
  @@index([patientId, createdAt])
  @@index([campaignId])
  @@index([status, expiresAt])
}
/// A one-off batch of messages to a filtered group of patients. Each recipient
/// gets their own MessageTask (never one group message).
model Campaign {
  id            String             @id @default(cuid())
  title         String
  /// Template used for every recipient (null when `customBody` is set).
  templateKey   MessageTemplateKey?
  /// Fixed wording for every recipient (null when `templateKey` is set).
  customBody    String?
  /// `PATIENT` → each patient's preferred language; `FIXED` → `fixedLanguage`.
  languageMode  String
  fixedLanguage String?
  /// Filter builder output (validated by the app, never trusted blindly).
  filterJson    Json
  status        CampaignStatus     @default(DRAFT)
  expiresAt     DateTime?          @db.Timestamptz
  /// User id of the creator (no FK — users are never deleted).
  createdBy     String
  createdAt     DateTime           @default(now()) @db.Timestamptz
  updatedAt     DateTime           @updatedAt @db.Timestamptz

  tasks MessageTask[]
}
