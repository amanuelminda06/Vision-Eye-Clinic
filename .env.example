# ── Database ─────────────────────────────────────────────────────────────────
# Local embedded Postgres (npm run db:up) by default. Point at any PostgreSQL
# server for production/teams — this URL is the only switch.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/vision_erp?schema=public"

# Embedded Postgres settings (used by scripts/db.mjs)
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=vision_erp

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32   (min 32 chars, validated at startup)
AUTH_SECRET=""

# Secret entry path: the staff login URL is /login/<LOGIN_SECRET_PATH>
# Generate: openssl rand -hex 12   (min 8 chars, letters/numbers/-/_ only)
LOGIN_SECRET_PATH="change-me-to-a-long-random-string"

# ── Seeded accounts (prisma/seed.ts, validated at startup) ───────────────────
# Passwords: min 10 characters. Change after first login / in production.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD=""
RECEPTION_EMAIL="reception@example.com"
RECEPTION_PASSWORD=""
STAFF_EMAIL="doctor@example.com"
STAFF_PASSWORD=""

# ── Uploads ──────────────────────────────────────────────────────────────────
# Staff photos (relative to the app root, or an absolute path)
UPLOAD_DIR="storage/uploads"

# ── Message jobs (optional) ──────────────────────────────────────────────────
# Bearer token for POST /api/jobs/messages, called by an external cron every
# 15 minutes (and nightly). Leave blank to disable the endpoint. Min 16 chars.
CRON_SECRET=""
