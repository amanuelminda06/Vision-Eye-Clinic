# ── Application ───────────────────────────────────────────────────────────────
# Generate APP_KEY: php artisan key:generate   (or: openssl rand -base64 32)
APP_NAME="Vision Eye Clinic"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinic.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# All datetimes are stored in UTC and displayed in the clinic timezone
# (Settings → timezone, default Africa/Addis_Ababa).
APP_TIMEZONE=UTC

# ── Database (target: MySQL 8.0 on the Plesk host) ────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vision_eye_clinic
# REQUIRED — Plesk → Databases → vision_eye_clinic (the user and the
# generated password). The app REFUSES TO SERVE while either one is empty.
DB_USERNAME=
DB_PASSWORD=
# Local development alternative (no MySQL needed): DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# The reverse proxy in front of Apache (Plesk nginx): the real scheme and
# the client IP arrive in the X-Forwarded-* headers. The loopback is the
# default (the proxy runs on the same host); use "*" only when the app is
# not directly reachable.
TRUSTED_PROXIES=127.0.0.1,::1

# ── Session / cache (single shared host: file/database drivers) ───────────────
SESSION_DRIVER=database
# 12-hour sessions (spec)
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once the site is served over HTTPS only:
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret entry path: the staff login URL is /login/<LOGIN_SECRET_PATH>
# Generate: openssl rand -hex 12   (min 8 chars, letters/numbers/-/_ only)
#
# It is DELIBERATELY EMPTY here: the app refuses to serve in production while
# it is empty, so a deployment can never end up with a guessable staff login
# URL. The install and the console commands run before it is set.
LOGIN_SECRET_PATH=

# ── Seeded accounts (DatabaseSeeder, validated at startup) ────────────────────
# Passwords: min 10 characters. Change after first login / in production.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD=""
RECEPTION_EMAIL="reception@example.com"
RECEPTION_PASSWORD=""
STAFF_EMAIL="doctor@example.com"
STAFF_PASSWORD=""

# ── Uploads ───────────────────────────────────────────────────────────────────
# Staff photos / patient ID photos (relative to the app root, or absolute)
UPLOAD_DIR="storage/uploads"
# db = store uploads as database blobs (default, survives disk wipes)
# local = store files under UPLOAD_DIR
STORAGE_DRIVER="db"

# ── Public website ────────────────────────────────────────────────────────────
# Canonical origin for the public website (metadata, JSON-LD, sitemap).
PUBLIC_BASE_URL=https://clinic.example.com

# Optional Cloudflare Turnstile — disabled when blank.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# ── Message jobs (optional) ───────────────────────────────────────────────────
# Bearer token for POST /api/jobs/messages (called by the scheduler/cron).
# Leave blank to disable the endpoint. Min 16 chars.
CRON_SECRET=""

# ── Mail (optional daily digest for OWNER; log driver works without a server) ─
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
